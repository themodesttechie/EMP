# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here_NEVER_COMMIT

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ifBash

# Email (Resend) - for ticket notifications
RESEND_API_KEY=re_your_key_here
RESEND_FROM=ifBash <service@ifbash.com>
RESEND_TEST_TO_OVERRIDE=
RESEND_INBOUND_SECRET=

# Tenant default (single-tenant dev mode; multi-tenant via tenant_id on rows)
DEFAULT_TENANT_SLUG=ifbash

# AI
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
AI_TENANT_MONTHLY_CAP_USD=200

# Cron
CRON_SECRET=

# Embeddings (KB semantic search)
OPENAI_API_KEY=sk-proj-...
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536
KB_DEFLECTION_THRESHOLD=0.75
