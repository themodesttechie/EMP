# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here_NEVER_COMMIT

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ifBash

# Email (Resend) - for ticket notifications
RESEND_API_KEY=re_your_key_here
RESEND_FROM=ifBash <noreply@entyti.com>
RESEND_TEST_TO_OVERRIDE=

# Tenant default (single-tenant dev mode; multi-tenant via tenant_id on rows)
DEFAULT_TENANT_SLUG=ifbash
